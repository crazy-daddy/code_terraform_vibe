{
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    "tools", "inspirations", "devtools/build_docs", "**/node_modules", "**/__pycache__", "**/.*", ".venv"
  ],
  "executionEnvironments": [
    {
      "root": "devtools",
      "extraPaths": [".pyright-resolved/lib", "tests"]
    },
    {
      "root": "tests",
      "reportArgumentType": "none",
      "extraPaths": [
        ".pyright-resolved/lib",
        "scripts/4_controlpanel/lib",
        "scripts/5_steampower/lib",
        "scripts/9_wildlife/lib",
        "autoplay/lib",
        "devtools",
        ".pyright-resolved/stubs"
      ]
    },
    {
      "root": "autoplay",
      "extraPaths": [
        "autoplay/lib",
        ".pyright-resolved/lib",
        ".pyright-resolved/stubs"
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        ".pyright-resolved/lib",
        ".pyright-resolved/stubs"
      ]
    }
  ]
}
