{
  "pythonVersion": "3.12",
  "venvPath": ".",
  "venv": ".venv",
  "exclude": [
    "tools", "inspirations", "out", "devtools/game_update/build_docs", "**/node_modules", "**/__pycache__", "**/.*", ".venv"
  ],
  "executionEnvironments": [
    {
      "root": "devtools/simulation/headless/standins",
      "extraPaths": [".pyright-resolved/stubs"]
    },
    {
      "root": "devtools",
      "extraPaths": [".pyright-resolved/lib", "autoplay/lib", "tests", "devtools", "devtools/code_scan", "devtools/perf", "devtools/play", "devtools/simulation", "devtools/game_update"]
    },
    {
      "root": "tests",
      "reportArgumentType": "none",
      "extraPaths": [
        ".pyright-resolved/lib",
        "scripts/4_controlpanel/lib",
        "scripts/5_steampower/lib",
        "scripts/9_wildlife/lib",
        "autoplay/lib",
        "devtools",
        "devtools/code_scan",
        "devtools/perf",
        "devtools/play",
        "devtools/simulation",
        "devtools/game_update",
        ".pyright-resolved/stubs"
      ]
    },
    {
      "root": "autoplay",
      "extraPaths": [
        "autoplay/lib",
        ".pyright-resolved/lib",
        ".pyright-resolved/stubs"
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        ".pyright-resolved/lib",
        ".pyright-resolved/stubs"
      ]
    }
  ]
}
