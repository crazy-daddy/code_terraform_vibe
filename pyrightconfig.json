{
  "pythonVersion": "3.12",
  "exclude": [
    "tools", "inspirations", "**/node_modules", "**/__pycache__", "**/.*", ".venv"
  ],
  "executionEnvironments": [
    {
      "root": "devtools",
      "extraPaths": [".pyright-resolved/lib"]
    },
    {
      "root": "tests",
      "extraPaths": [
        ".pyright-resolved/lib",
        "scripts/4_controlpanel/lib",
        ".pyright-resolved/stubs"
      ]
    },
    {
      "root": ".",
      "extraPaths": [
        ".pyright-resolved/lib",
        ".pyright-resolved/stubs"
      ]
    }
  ]
}
